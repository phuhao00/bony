+#[test]
+fn normalizes_grok_args_to_agent_stdio() {
+    assert_eq!(
+        normalize_agent_args("grok", Vec::new()),
+        vec!["agent".to_string(), "stdio".to_string()]
+    );
+    assert_eq!(
+        normalize_agent_args("grok", vec!["agent".into(), "stdio".into()]),
+        vec!["agent".to_string(), "stdio".to_string()]
+    );
+    // Custom args are preserved when the caller is explicit.
+    assert_eq!(
+        normalize_agent_args("grok", vec!["agent".into(), "stdio".into(), "--cwd".into()]),
+        vec![
+            "agent".to_string(),
+            "stdio".to_string(),
+            "--cwd".to_string()
+        ]
+    );
+    assert_eq!(
+        managed_agent_avatar_url("grok"),
+        Some(GROK_AVATAR_URL.to_string())
+    );
+}
