{
  "$schema": "https://opencode.ai/config.json",
  // Alibaba Bailian Coding Plan (sk-sp-*). Key lives in env / .local-runtime only.
  // See: https://help.aliyun.com/zh/model-studio/coding-plan
  "provider": {
    "bailian-coding-plan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Bailian Coding Plan",
      "options": {
        "baseURL": "https://coding.dashscope.aliyuncs.com/v1",
        "apiKey": "{env:BAILIAN_CODING_PLAN_API_KEY}"
      },
      "models": {
        "qwen3-coder-plus": {
          "name": "Qwen3 Coder Plus"
        },
        "qwen3.6-plus": {
          "name": "Qwen3.6 Plus"
        },
        "qwen3.7-plus": {
          "name": "Qwen3.7 Plus"
        },
        "qwen3-coder-next": {
          "name": "Qwen3 Coder Next"
        },
        "qwen3-max-2026-01-23": {
          "name": "Qwen3 Max 2026-01-23"
        },
        "kimi-k2.5": {
          "name": "Kimi K2.5"
        },
        "glm-5": {
          "name": "GLM-5"
        },
        "glm-4.7": {
          "name": "GLM-4.7"
        },
        "MiniMax-M2.5": {
          "name": "MiniMax M2.5"
        },
        "qwen3.5-plus": {
          "name": "Qwen3.5 Plus"
        }
      }
    }
  },
  "model": "bailian-coding-plan/qwen3-coder-plus",
  "disabled_providers": []
}
