/third_party/buzz/**/dist/
/third_party/buzz/**/.turbo/
/third_party/buzz/.env

# Local agent smoke / relay logs
/tmp-*.log
/tmp-*.err
/tmp-*.out
/tmp-*.diff
tmp-*.log
tmp-*.out
tmp-*.err
tmp-buzz*.diff
tmp-discovery*.diff
